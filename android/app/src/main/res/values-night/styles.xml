<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Theme aplicado enquanto o app está iniciando (SPLASH SCREEN),
      mesmo com o celular em modo escuro.
      Forçamos Theme.Light para evitar tela preta.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Edge-to-edge system bars (still light to avoid black flash) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!--
      Theme aplicado logo após o start, enquanto o Flutter
      ainda está inicializando.
      Mantemos claro para evitar flash escuro antes do Flutter.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Edge-to-edge system bars (still light to avoid black flash) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

</resources>
